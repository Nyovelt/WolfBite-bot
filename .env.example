# Telegram Bot Token
TELEGRAM_TOKEN=your_telegram_bot_token

# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token

# OLLAMA Configuration
# If running Ollama on your host machine, you may need to use http://host.docker.internal:11434 on Docker Desktop
# or add `--network=host` to your docker run command on Linux.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2
